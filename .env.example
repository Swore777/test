# Публичный HTTPS-адрес стенда (нужен Telegram для Mini App и webhook)
PUBLIC_URL=https://catalog.example.com
HTTP_PORT=8080

BOT_TOKEN=123456:ABC...
# Telegram user id администраторов через запятую
ADMIN_IDS=111111111
# webhook — несколько реплик бота; polling — одна реплика для локальной отладки (BOT_REPLICAS=1)
BOT_MODE=webhook
BOT_REPLICAS=2
WEBHOOK_SECRET=change-me-random-string

# Токен, которым бот авторизуется в API при создании товара
ADMIN_API_TOKEN=change-me-random-string

POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=change-me

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-min-8-chars
S3_BUCKET=products
